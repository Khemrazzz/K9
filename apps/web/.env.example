# Copy to .env.local (git-ignored). All values are server-side only.

# Public URL of this app. HTTPS turns on Secure, __Host- prefixed cookies.
K9_APP_URL=http://localhost:3000
# The K9 API, called server-to-server.
K9_API_URL=http://localhost:5080

# Keycloak realm (must match the API's Auth:Authority).
K9_OIDC_ISSUER=http://localhost:8081/realms/k9
K9_OIDC_CLIENT_ID=k9-web
# Same value as K9_WEB_CLIENT_SECRET in the repository root .env.
K9_OIDC_CLIENT_SECRET=change-me
# Local development only: allows the plain-HTTP Keycloak above.
K9_OIDC_ALLOW_HTTP=true

# Encrypts the session cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
K9_SESSION_SECRET=change-me-to-at-least-32-random-characters

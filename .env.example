# Copy to .env (git-ignored) and replace every value before the first `docker compose up`.
# Postgres roles and Keycloak users are created from these on first start only;
# changing them later requires `docker compose down -v` to recreate the volume.

POSTGRES_SUPERUSER_PASSWORD=change-me
# Owns the k9 database and runs migrations.
K9_OWNER_PASSWORD=change-me
# Runtime role for the API: no DDL, cannot bypass row-level security.
K9_APP_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

KEYCLOAK_ADMIN_PASSWORD=change-me
K9_WEB_CLIENT_SECRET=change-me
# Password for the dev users alice@acme.test and bob@globex.test.
K9_DEV_USER_PASSWORD=change-me

# Optional host port overrides.
# K9_POSTGRES_PORT=5432
# K9_KEYCLOAK_PORT=8081
